# Copy to web/.env.local and fill in. Never commit the real file.

# Demo mode: "true" runs the whole app on localStorage with canned
# interpretations. No Supabase project or Anthropic key needed.
NEXT_PUBLIC_DEMO_MODE=true

# Supabase (Project Settings -> API). Only needed when demo mode is "false".
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Anthropic (console.anthropic.com -> API Keys). Server-side only.
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL_MAIN=claude-sonnet-4-6

